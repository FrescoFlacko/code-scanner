{
  "name": "code-scanner",
  "version": "1.0.0",
  "description": "A code quality scanning tool built on ESLint",
  "type": "module",
  "main": "./dist/src/scanner/index.js",
  "types": "./dist/src/scanner/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/scanner/index.d.ts",
      "default": "./dist/src/scanner/index.js"
    }
  },
  "bin": {
    "code-scanner": "./bin/scanner.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scan": "npm run build && node bin/scanner.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "eslint",
    "code-quality",
    "static-analysis",
    "linter",
    "cli",
    "code-scanner",
    "complexity",
    "security",
    "maintainability"
  ],
  "files": [
    "dist",
    "bin",
    "scanner.config.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "glob": "^13.0.0",
    "micromatch": "^4.0.8",
    "typescript-eslint": "^8.50.1"
  },
  "devDependencies": {
    "@types/eslint-plugin-security": "^3.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
