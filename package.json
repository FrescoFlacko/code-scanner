{
  "name": "code-scanner",
  "version": "1.1.0",
  "description": "A code quality scanning tool built on ESLint",
  "type": "module",
  "main": "./dist/src/scanner/index.js",
  "types": "./dist/src/scanner/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/scanner/index.d.ts",
      "default": "./dist/src/scanner/index.js"
    }
  },
  "bin": {
    "code-scanner": "./bin/scanner.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "scan": "npm run build && node bin/scanner.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "eslint",
    "code-quality",
    "static-analysis",
    "linter",
    "cli",
    "code-scanner",
    "complexity",
    "security",
    "maintainability"
  ],
  "files": [
    "dist",
    "bin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "micromatch": "^4.0.8",
    "string-width": "^8.2.2",
    "typescript-eslint": "^8.63.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
